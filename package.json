{
  "name": "agent-native-monorepo",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:service": "turbo test:service",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "eval": "turbo eval",
    "eval:promote-live": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service eval:promote-live",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "node scripts/lint-docs.mjs && node --test 'scripts/*.test.mjs'",
    "controls:matrix": "node scripts/lint-controls.mjs --write",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion@^1.1.7": "^1.1.18",
    "brace-expansion@^2.0.2": "^2.1.4",
    "brace-expansion@^5.0.5": "^5.0.9",
    "browserslist": "^4.28.8",
    "form-data": "^4.0.6",
    "ip-address": "^10.3.1",
    "js-yaml@^3.13.1": "^3.15.2",
    "js-yaml@^4.3.0": "^4.3.2",
    "langsmith": "^0.6.0",
    "multer": "^2.3.0",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.18",
    "protobufjs": "^7.6.5",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.19",
    "vite-node/vite": "^7.3.6",
    "vitest/vite": "^7.3.6"
  }
}
