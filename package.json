{
  "name": "agent-native-monorepo",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:service": "turbo test:service",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "eval": "turbo eval",
    "eval:retrieval": "turbo eval:retrieval",
    "eval:explanation": "turbo eval:explanation",
    "eval:promote-live": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service eval:promote-live",
    "canary": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service canary",
    "audit:replay": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service audit:replay",
    "ledger:migrate": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service ledger:migrate",
    "ledger:verify": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service ledger:verify",
    "ledger:anchor": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service ledger:anchor",
    "ledger:export": "turbo build --filter=@repo/agent-service... --output-logs=errors-only && yarn workspace @repo/agent-service ledger:export",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "node scripts/lint-docs.mjs && node scripts/lint-data.mjs && node --test 'scripts/*.test.mjs'",
    "controls:matrix": "node scripts/lint-controls.mjs --write",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.5",
    "brace-expansion@^1.1.7": "^1.1.20",
    "brace-expansion@^2.0.2": "^2.1.6",
    "brace-expansion@^5.0.5": "^5.0.11",
    "browserslist": "^4.28.8",
    "form-data": "^4.0.6",
    "glob@^10.3.7": "^14.0.2",
    "glob@^13.0.0": "^14.0.2",
    "ip-address": "^10.7.1",
    "js-yaml@^3.13.1": "^3.15.2",
    "js-yaml@^4.3.0": "^4.3.2",
    "langsmith": "^0.6.0",
    "minimatch@^10.2.2": "^11.0.1",
    "multer": "^2.5.0",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.18",
    "protobufjs": "^7.6.5",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.19",
    "vite-node/vite": "^7.3.6",
    "vitest/vite": "^7.3.7"
  }
}
