{
  "name": "agent-native-monorepo",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "test:eval": "turbo test:eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.7"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.4",
    "brace-expansion@^1.1.7": "^1.1.16",
    "brace-expansion@^2.0.2": "^2.1.2",
    "brace-expansion@^5.0.5": "^5.0.8",
    "form-data": "^4.0.6",
    "js-yaml@^3.13.1": "^3.15.0",
    "js-yaml@^4.1.1": "^4.3.0",
    "langsmith": "^0.6.0",
    "multer": "^2.2.0",
    "postcss": "^8.5.18",
    "protobufjs": "^7.6.5",
    "shell-quote": "^1.8.4",
    "tar": "^7.5.19",
    "vite-node/vite": "^7.3.6",
    "vitest/vite": "^7.3.6"
  }
}
