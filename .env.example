# Postgres (with pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentdb

# Neo4j 5
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Google Gemini (AI Studio). Optional: with no key the service runs the graph against a
# deterministic stub dependency set, which is what CI exercises.
#
# The live set works. Chat is gemini-2.5-flash and embeddings are gemini-embedding-001 at
# 768 dimensions, L2-normalized — see row 16 of docs/STATUS.md.
#
# A real environment variable beats this file. If a shell rc exports GOOGLE_API_KEY, that
# value wins and the service logs env.file.shadowed naming it.
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Decision ledger (P3-C). Optional, and commented out: unset means no ledger. It needs the
# memory axis above, and it never falls back to DATABASE_URL. Set up once as the owner:
#   LEDGER_OWNER_URL=postgresql://postgres:postgres@localhost:5432/agentdb \
#   LEDGER_WRITER_PASSWORD=change-me yarn ledger:migrate
# then let the service write as ledger_writer, which can SELECT and INSERT and nothing else.
# LEDGER_DATABASE_URL=postgresql://ledger_writer:change-me@localhost:5432/agentdb
# ledger:anchor and ledger:verify: an RFC 3161 authority and the CA that vouches for it.
# LEDGER_TSA_URL=https://freetsa.org/tsr
# LEDGER_TSA_CA=/path/to/the-authority-ca.pem

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent-service

# Docker Compose (--profile full)
# These are only needed when running `docker compose --profile full up`.
# The compose file sets inter-container defaults (e.g., postgres:5432 instead
# of localhost:5432), so you typically only need GOOGLE_API_KEY above.
AGENT_SERVICE_URL=http://agent-service:3000
GATEWAY_PORT=3001

# Host ports the stores publish on. Change them when another project already
# holds 5432 or 7687, and point DATABASE_URL and NEO4J_URI above at the same
# ports. Inside the compose network the stores stay on 5432 and 7687.
# POSTGRES_HOST_PORT=5432
# NEO4J_BOLT_HOST_PORT=7687
# NEO4J_HTTP_HOST_PORT=7474

# Service authentication (P5-A, ADR 0014). Unset runs open: every caller is served
# without a credential, and boot logs auth.open at warn. Set it to comma-separated
# principal:sha256hex pairs — the digest of each token, never the token — and every route
# but /health and the two /.well-known documents needs `Authorization: Bearer <token>`.
# A digest: printf '%s' "$TOKEN" | sha256sum
# SERVICE_CREDENTIALS=console:<sha256 hex of the console's token>

# The console's token, for the Vite dev proxy to send when the service enforces one.
# CONSOLE_SERVICE_TOKEN=

# A2A (P5-A). Where a caller reaches the service, for the Agent Card's interface URL.
# Unset is http://localhost:3000; compose sets the gateway's.
# A2A_PUBLIC_URL=http://localhost:3001
#
# PKCS#8 P-256 private keys that sign the Agent Card, comma-separated paths. Unset serves
# the card unsigned. `node scripts/a2a-keygen.mjs <path>` writes one. To rotate, add the new
# path, wait out the card's one-hour Cache-Control, then remove the old one.
# A2A_CARD_SIGNING_KEYS=
