# Recorded embeddings and the ablation's reports, for the same reason: the first
# is a recording, and the second is compared byte for byte between runs.
packages/eval-harness/datasets/*/recorded/
packages/eval-harness/datasets/retrieval-ablation/reports/
packages/eval-harness/datasets/retrieval-ablation/adjudication/

