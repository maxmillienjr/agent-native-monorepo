# Recorded cassettes. They are artifacts of a live run, not source: reformatting
# one edits a recording, and `yarn format` must not be a way to do that casually.
packages/eval-harness/datasets/*/cassettes/

# Gate baselines (P1-D). Generated by `EVAL_GATE=update` one cell per line, so a
# pull request's diff of the file reads as the behaviour it changes; Prettier
# would spread each cell over seven lines and bury it.
packages/eval-harness/datasets/*/baselines/

# Agent worktrees are whole checkouts; formatting from the root must not descend
# into them.
.claude/worktrees/
