{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["build"]
    },
    "@repo/agent-cassette#test:unit": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/eval-harness/datasets/*/cassettes/**"]
    },
    "test:service": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "REQUIRE_INTEGRATION_ENV"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["E2E_BASE_URL"]
    },
    "eval": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "GOOGLE_API_KEY",
        "DATABASE_URL",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "EVAL_TRIALS",
        "EVAL_OUTPUT_DIR",
        "EVAL_CASSETTE_MODE",
        "EVAL_EXPECT_AXES",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "LOG_LEVEL",
        "EVAL_GATE",
        "EVAL_HISTORY_DIR",
        "EVAL_TASKS",
        "EVAL_CHAT_MODEL",
        "EVAL_SUITE"
      ]
    },
    "eval:retrieval": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "GOOGLE_API_KEY",
        "DATABASE_URL",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "EVAL_OUTPUT_DIR",
        "EVAL_EMBEDDINGS_MODE"
      ]
    },
    "eval:explanation": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "GOOGLE_API_KEY",
        "DATABASE_URL",
        "NEO4J_URI",
        "NEO4J_USER",
        "NEO4J_PASSWORD",
        "EVAL_OUTPUT_DIR"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
