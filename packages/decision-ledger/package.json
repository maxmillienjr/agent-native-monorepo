{
  "name": "@repo/decision-ledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/test-tsa.d.ts",
      "default": "./dist/testing/test-tsa.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@repo/determination": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/agent-cassette": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
