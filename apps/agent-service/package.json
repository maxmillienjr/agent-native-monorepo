{
  "name": "@repo/agent-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test:service": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts && NODE_OPTIONS=--experimental-vm-modules jest test/review.e2e-spec.ts test/appeal.e2e-spec.ts",
    "audit:replay": "node dist/audit/replay.js",
    "ledger:migrate": "node dist/ledger/migrate.js",
    "ledger:verify": "node dist/ledger/verify.js",
    "ledger:anchor": "node dist/ledger/anchor.js",
    "ledger:export": "node dist/ledger/export.js",
    "eval": "node dist/eval/run-eval.js",
    "eval:retrieval": "node dist/eval/run-retrieval-ablation.js",
    "eval:explanation": "node dist/eval/run-explanation.js",
    "eval:history": "node dist/eval/eval-history.js",
    "eval:promote-live": "node dist/eval/promote-live.js",
    "canary": "node dist/eval/canary/run-canary.js",
    "canary:compare": "node dist/eval/canary/run-compare.js",
    "review:sign": "node dist/review/sign-cli.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "~1.3.0",
    "@langchain/core": "^1.3.1",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@repo/agent-cassette": "workspace:*",
    "@repo/agent-contracts": "workspace:*",
    "@repo/decision-ledger": "workspace:*",
    "@repo/determination": "workspace:*",
    "@repo/eval-harness": "workspace:*",
    "@repo/memory-core": "workspace:*",
    "@repo/prior-auth": "workspace:*",
    "@repo/shared-types": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "canonicalize": "^2.1.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
